# Optional: override SQL API URL.
# Default (omit this file): POST directly to the hackathon worker (CORS is open:
# access-control-allow-origin: *).
#
# If your browser/network blocks cross-origin POST, use the Vite dev proxy:
#   VITE_QUERY_URL=/api/query
# `vite.config.ts` maps /api/query -> https://uic-hackathon-data.christian-7f4.workers.dev/query
#
# For a different deployed proxy, set the full URL:
#   VITE_QUERY_URL=https://your-worker.example.com/query
#
# VITE_QUERY_URL=
