{
	"name": "agent",
	"version": "1.0.0",
	"private": true,
	"description": "Cost explainer AI agent on Cloudflare",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"start": "vite dev",
		"deploy": "vite build && wrangler deploy",
		"types": "wrangler types env.d.ts --include-runtime false",
		"format": "oxfmt --write .",
		"lint": "oxlint src/",
		"check": "oxfmt --check . && oxlint src/ && tsc"
	},
	"dependencies": {
		"@cloudflare/ai-chat": "^0.6.0",
		"agents": "^0.12.0",
		"ai": "^6.0.170",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"workers-ai-provider": "^3.1.13",
		"zod": "^4.4.1"
	},
	"devDependencies": {
		"@babel/plugin-proposal-decorators": "^7.29.0",
		"@cloudflare/vite-plugin": "1.34.0",
		"@cloudflare/workers-types": "^4.20260430.1",
		"@rolldown/plugin-babel": "^0.2.3",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"oxfmt": "^0.47.0",
		"oxlint": "^1.62.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.10",
		"wrangler": "4.86.0"
	}
}
